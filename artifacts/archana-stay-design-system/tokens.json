{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#f9f6f1" },
      "foreground": { "$value": "#19263e" },
      "border": { "$value": "#e4ddd3" },
      "card": { "$value": "#fdfdfc" },
      "cardForeground": { "$value": "#19263e" },
      "popover": { "$value": "#fdfdfc" },
      "popoverForeground": { "$value": "#19263e" },
      "primary": {
        "$value": "#152f60",
        "$description": "Primary brand color. Drives buttons, links, and emphasis."
      },
      "primaryForeground": { "$value": "#fdfdfc" },
      "secondary": { "$value": "#f2ede3" },
      "secondaryForeground": { "$value": "#19263e" },
      "muted": { "$value": "#eeeae3" },
      "mutedForeground": { "$value": "#617089" },
      "accent": { "$value": "#d7a028" },
      "accentForeground": { "$value": "#11254b" },
      "destructive": { "$value": "#ba332c" },
      "destructiveForeground": { "$value": "#fdfdfc" },
      "input": { "$value": "#e4ddd3" },
      "ring": { "$value": "#d7a028" },
      "chart1": { "$value": "#152f60" },
      "chart2": { "$value": "#d7a028" },
      "chart3": { "$value": "#617089" },
      "chart4": { "$value": "#ba332c" },
      "chart5": { "$value": "#2f7d78" },
      "sidebar": { "$value": "#f2ede3" },
      "sidebarForeground": { "$value": "#19263e" },
      "sidebarBorder": { "$value": "#e4ddd3" },
      "sidebarPrimary": { "$value": "#152f60" },
      "sidebarPrimaryForeground": { "$value": "#fdfdfc" },
      "sidebarAccent": { "$value": "#eeeae3" },
      "sidebarAccentForeground": { "$value": "#11254b" },
      "sidebarRing": { "$value": "#d7a028" }
    },
    "dark": {
      "background": { "$value": "#0f1624" },
      "foreground": { "$value": "#f8f3e8" },
      "border": { "$value": "#2f3b51" },
      "card": { "$value": "#151f32" },
      "cardForeground": { "$value": "#f8f3e8" },
      "popover": { "$value": "#151f32" },
      "popoverForeground": { "$value": "#f8f3e8" },
      "primary": { "$value": "#ddad46" },
      "primaryForeground": { "$value": "#0f1624" },
      "secondary": { "$value": "#253146" },
      "secondaryForeground": { "$value": "#f8f3e8" },
      "muted": { "$value": "#253146" },
      "mutedForeground": { "$value": "#c2baad" },
      "accent": { "$value": "#ddad46" },
      "accentForeground": { "$value": "#0f1624" },
      "destructive": { "$value": "#cf554d" },
      "destructiveForeground": { "$value": "#f8f3e8" },
      "input": { "$value": "#2f3b51" },
      "ring": { "$value": "#ddad46" },
      "chart1": { "$value": "#ddad46" },
      "chart2": { "$value": "#6eb3ad" },
      "chart3": { "$value": "#c2baad" },
      "chart4": { "$value": "#cf554d" },
      "chart5": { "$value": "#6e91c8" },
      "sidebar": { "$value": "#151f32" },
      "sidebarForeground": { "$value": "#f8f3e8" },
      "sidebarBorder": { "$value": "#2f3b51" },
      "sidebarPrimary": { "$value": "#ddad46" },
      "sidebarPrimaryForeground": { "$value": "#0f1624" },
      "sidebarAccent": { "$value": "#253146" },
      "sidebarAccentForeground": { "$value": "#f8f3e8" },
      "sidebarRing": { "$value": "#ddad46" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["DM Sans", "sans-serif"],
        "$description": "Default UI and body typeface, extracted from the Archana Stay app."
      },
      "serif": {
        "$value": ["Fraunces", "serif"],
        "$description": "Display and editorial heading typeface."
      },
      "mono": { "$value": ["DM Sans", "sans-serif"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "1rem",
      "$description": "Soft, welcoming base radius; smaller controls derive from this token."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Four-pixel rhythm used across controls, cards, sections, and grids."
    }
  }
}
